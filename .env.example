# ============================================================
# Apollo Contact Database Checker - Environment Configuration
# ============================================================

# Database Configuration (AWS RDS MySQL)
DB_HOST=kapilcapital.c7kco0ae2ebh.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=nestack
DB_PASSWORD=your_db_password_here
DB_NAME=apollo_scrapers
DB_TABLE=emails

# OpenAI Configuration (for on-demand classification of unrecognized titles)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_DOMAIN_MODEL=gpt-4o-mini

# Optional: TypeSafe System One/Jev reviews ambiguous company matches only.
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_MAX_COMPANIES_PER_SESSION=250

# Deduplication & Guardrail Settings
MAX_CONTACTS_PER_COMPANY=1
GUARDRAILS_ENABLED=true

# MillionVerifier Bulk Verification Configuration
MILLIONVERIFIER_API_KEY=your_millionverifier_api_key_here
MILLIONVERIFIER_BULK_BASE_URL=https://bulkapi.millionverifier.com

# Freshsales CRM Configuration (for automated lead sync)
FRESHSALES_DOMAIN=https://your-domain.freshsales.io
FRESHSALES_API_KEY=your_freshsales_api_key_here
DEFAULT_OWNER_ID=your_owner_id_here

# WhatsApp Daily Expiry Alert Configuration (CallMeBot - 100% Free)
# 1. Message +34 644 44 20 84 on WhatsApp with: "I allow callmebot to send me messages"
# 2. Enter your phone number (with country code, e.g. +919876543210) and the apikey received:
WHATSAPP_PHONE_NUMBER=+919876543210
WHATSAPP_CALLMEBOT_APIKEY=your_callmebot_apikey_here

# Telegram Alerts Configuration (100% Free & Private)
# 1. Message @BotFather on Telegram to create a bot and get token
# 2. Get your Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

